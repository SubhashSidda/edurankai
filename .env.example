# Supabase PostgreSQL Configuration
# Retrieve these credentials from your Supabase Dashboard:
# 1. Go to https://supabase.com/dashboard/project/_/settings/api
# 2. Copy the Project URL and Anon Key
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role Secret Key (CRITICAL: SERVER-ONLY)
# Found in Supabase Dashboard -> Settings -> API -> "service_role" (secret)
# NEVER expose this key in client-side code, public repositories, or browser bundles.
# This key is strictly used by server-side Route Handlers to bypass client RLS for administrative management.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Application Base URL
APP_URL="http://localhost:3000"
